msgid "Are you sure you want to leave the list \"{title}\"? You will no longer have access to it unless it is shared with you again."
msgstr "Er du sikker på at du vil forlate listen «{title}»? Du vil ikke lenger ha tilgang til den med mindre den blir delt med deg igjen."

msgid "Leave"
msgstr "Forlat"

msgid "You left the list"
msgstr "Du har forlatt listen"

msgid "Could not leave list"
msgstr "Kunne ikke forlate listen"

msgid "Are you sure you want to delete the list \"{title}\"? This will also remove all its items and categories."
msgstr "Er du sikker på at du vil slette listen «{title}»? Dette fjerner også alle varene og kategoriene i den."

msgid "Are you sure you want to delete this list? This will also remove all its items and categories."
msgstr "Er du sikker på at du vil slette denne listen? Dette fjerner også alle varene og kategoriene i den."

msgid "This category contains %n item. Deleting the category will also delete this item. Continue?"
msgid_plural "This category contains %n items. Deleting the category will also delete these items. Continue?"
msgstr[0] "Denne kategorien inneholder %n vare. Hvis du sletter kategorien, slettes også denne varen. Fortsette?"
msgstr[1] "Denne kategorien inneholder %n varer. Hvis du sletter kategorien, slettes også disse varene. Fortsette?"
