msgid "New list"
msgstr "Новий список"

msgid "Loading lists…"
msgstr "Завантаження списків…"

msgid "No grocery lists, yet"
msgstr "Списків покупок ще немає"

msgid "No list selected"
msgstr "Список не вибрано"

msgid "Create a list to start adding items."
msgstr "Створіть список, щоб почати додавати товари."

msgid "Select a list in the navigation."
msgstr "Виберіть список у навігації."

msgid "List name"
msgstr "Назва списку"

msgid "My grocery list"
msgstr "Мій список покупок"

msgid "Show only unchecked"
msgstr "Показувати лише невідмічені"

msgid "Hide category"
msgstr "Приховати категорії"

msgid "Create list"
msgstr "Створити список"

msgid "Could not load the lists"
msgstr "Не вдалося завантажити списки"

msgid "Could not rename the list"
msgstr "Не вдалося перейменувати список"

msgid "Could not create the list"
msgstr "Не вдалося створити список"

msgid "Jump to letter"
msgstr "Перейти до літери"

msgid "Jump to {letter}"
msgstr "Перейти до {letter}"

msgid "Drag to reorder"
msgstr "Перетягніть, щоб змінити порядок"

msgid "Category color"
msgstr "Колір категорії"

msgid "Pick color"
msgstr "Вибрати колір"

msgid "Category name"
msgstr "Назва категорії"

msgid "Save changed category"
msgstr "Зберегти змінену категорію"

msgid "Edit category"
msgstr "Редагувати категорію"

msgid "Delete category"
msgstr "Вилучити категорію"

msgid "Could not update category color"
msgstr "Не вдалося змінити колір категорії"

msgid "Could not delete category"
msgstr "Не вдалося вилучити категорію"

msgid "Cancel"
msgstr "Скасувати"

msgid "Delete"
msgstr "Вилучити"

msgid "Category name must not be empty"
msgstr "Назва категорії не може бути порожньою"

msgid "A category named \"{category}\" already exists"
msgstr "Категорія з назвою «{category}» вже існує"

msgid "Could not rename category"
msgstr "Не вдалося перейменувати категорію"

msgid "Add category {category}"
msgstr "Додати категорію {category}"

msgid "Could not add category"
msgstr "Не вдалося додати категорію"

msgid "Unsnooze"
msgstr "Повернути"

msgid "Snooze"
msgstr "Відкласти"

msgid "Could not unsnooze item"
msgstr "Не вдалося повернути відкладений товар"

msgid "Could not check item"
msgstr "Не вдалося відмітити товар"

msgid "Could not snooze item"
msgstr "Не вдалося відкласти товар"

msgid "Share with"
msgstr "Поділитися з"

msgid "Search for users …"
msgstr "Пошук користувачів…"

msgid "Owner (you)"
msgstr "Власник (ви)"

msgid "Shared with you by {owner}"
msgstr "{owner} поділився(-лася) з вами"

msgid "You"
msgstr "Ви"

msgid "Unshare with {name}"
msgstr "Закрити доступ для {name}"

msgid "Unshare"
msgstr "Закрити доступ"

msgid "Share this list with other users so you can shop together. Everyone it is shared with can add, edit and check off items."
msgstr "Поділіться цим списком з іншими користувачами, щоб робити покупки разом. Усі, з ким ним поділилися, можуть додавати, редагувати та відмічати товари."

msgid "Could not fetch sharees"
msgstr "Не вдалося отримати учасників спільного доступу"

msgid "Could not search users"
msgstr "Не вдалося виконати пошук користувачів"

msgid "Could not share list with {name}"
msgstr "Не вдалося поділитися списком з {name}"

msgid "Could not unshare list with {name}"
msgstr "Не вдалося закрити доступ до списку для {name}"

msgid "Settings"
msgstr "Налаштування"

msgid "Rename {list}"
msgstr "Перейменувати {list}"

msgid "Grocery list"
msgstr "Список покупок"

msgid "Add item"
msgstr "Додати товар"

msgid "Add"
msgstr "Додати"

msgid "No items, yet"
msgstr "Товарів ще немає"

msgid "Add the first item with the Add button."
msgstr "Додайте перший товар за допомогою кнопки «Додати»."

msgid "All done"
msgstr "Усе готово"

msgid "Every item is checked or snoozed."
msgstr "Усі товари відмічено або відкладено."

msgid "Uncategorized"
msgstr "Без категорії"

msgid "Edit item"
msgstr "Редагувати товар"

msgid "Item name"
msgstr "Назва товару"

msgid "e.g. Milk, Bread, Eggs…"
msgstr "наприклад, молоко, хліб, яйця…"

msgid "Quantity"
msgstr "Кількість"

msgid "1"
msgstr "1"

msgid "Increase quantity"
msgstr "Збільшити кількість"

msgid "Decrease quantity"
msgstr "Зменшити кількість"

msgid "Select or create a category…"
msgstr "Виберіть або створіть категорію…"

msgid "Save"
msgstr "Зберегти"

msgid "Could not update the list"
msgstr "Не вдалося оновити список"

msgid "Could not load the list"
msgstr "Не вдалося завантажити список"

msgid "Could not load the categories"
msgstr "Не вдалося завантажити категорії"

msgid "Could not load the items"
msgstr "Не вдалося завантажити товари"

msgid "Please enter a name for the item"
msgstr "Введіть назву товару"

msgid "Could not add item"
msgstr "Не вдалося додати товар"

msgid "Could not update item category"
msgstr "Не вдалося змінити категорію товару"

msgid "Could not delete item"
msgstr "Не вдалося вилучити товар"

msgid "Categories"
msgstr "Категорії"

msgid "Categories loading…"
msgstr "Завантаження категорій…"

msgid "No categories, yet"
msgstr "Категорій ще немає"

msgid "Sharing"
msgstr "Спільний доступ"

msgid "Danger zone"
msgstr "Небезпечна зона"

msgid "Leave list"
msgstr "Залишити список"

msgid "Delete list"
msgstr "Вилучити список"

msgid "Could not save category order"
msgstr "Не вдалося зберегти порядок категорій"

msgid "List deleted"
msgstr "Список вилучено"

msgid "Could not delete list"
msgstr "Не вдалося вилучити список"

msgid "Are you sure you want to leave the list \"{title}\"? You will no longer have access to it unless it is shared with you again."
msgstr "Ви дійсно хочете залишити список «{title}»? Ви втратите до нього доступ, доки ним знову не поділяться з вами."

msgid "Leave"
msgstr "Залишити"

msgid "You left the list"
msgstr "Ви залишили список"

msgid "Could not leave list"
msgstr "Не вдалося залишити список"

msgid "Are you sure you want to delete the list \"{title}\"? This will also remove all its items and categories."
msgstr "Ви дійсно хочете вилучити список «{title}»? Також буде вилучено всі його товари та категорії."

msgid "Are you sure you want to delete this list? This will also remove all its items and categories."
msgstr "Ви дійсно хочете вилучити цей список? Також буде вилучено всі його товари та категорії."

msgid "This category contains %n item. Deleting the category will also delete this item. Continue?"
msgid_plural "This category contains %n items. Deleting the category will also delete these items. Continue?"
msgstr[0] "Ця категорія містить %n товар. Під час вилучення категорії цей товар також буде вилучено. Продовжити?"
msgstr[1] "Ця категорія містить %n товари. Під час вилучення категорії ці товари також буде вилучено. Продовжити?"
msgstr[2] "Ця категорія містить %n товарів. Під час вилучення категорії ці товари також буде вилучено. Продовжити?"
msgstr[3] "Ця категорія містить %n товару. Під час вилучення категорії ці товари також буде вилучено. Продовжити?"
