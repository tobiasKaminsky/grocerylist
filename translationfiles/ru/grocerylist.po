msgstr "Загрузка категорий…"

msgid "No categories, yet"
msgstr "Категорий пока нет"

msgid "Sharing"
msgstr "Общий доступ"

msgid "Danger zone"
msgstr "Опасная зона"

msgid "Leave list"
msgstr "Покинуть список"

msgid "Delete list"
msgstr "Удалить список"

