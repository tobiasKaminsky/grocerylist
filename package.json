    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.14.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-material-design-icons": "^5.3.1",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
