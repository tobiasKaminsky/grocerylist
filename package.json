  },
  "license": "agpl",
  "author": "Tobias Kaminsky <tobias@kaminsky.me>",
  "contributors": [],
  "type": "module",
  "scripts": {
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
    "lint": "eslint",
